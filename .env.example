# ============================================================
# lab_reserve 环境变量模板
#
# 用法：
#   cp .env.example .env
#   然后把下面的 change-me-* 全部替换成真实值
#
# ⚠️ .env 已被 .gitignore 忽略 —— 绝对不要提交
# ⚠️ OSS / SMTP 凭据只在这里出现，不要写进任何 .md / .yml / .java
# ============================================================

# ---------- 通用 ----------
TZ=Asia/Shanghai

# ---------- MySQL ----------
# MYSQL_HOST: 本地开发用 localhost；docker compose 会覆盖为 mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lab_reserve
MYSQL_ROOT_PASSWORD=change-me-root-pwd
MYSQL_USER=lab_reserve
MYSQL_PASSWORD=change-me-app-pwd

# ---------- Redis ----------
# REDIS_HOST: 本地开发用 localhost；docker compose 会覆盖为 redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-pwd

# ---------- 后端 ----------
BACKEND_PORT=8080
# JWT 签名密钥：至少 32 字节的随机串
# 生成方式：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# Access Token 有效期（秒），默认 2 小时
JWT_ACCESS_EXPIRE=7200
# Refresh Token 有效期（秒），默认 7 天
JWT_REFRESH_EXPIRE=604800

# ---------- 阿里云 OSS（迭代 7 用到）----------
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=change-me-bucket
OSS_ACCESS_KEY_ID=change-me-access-key-id
OSS_ACCESS_KEY_SECRET=change-me-access-key-secret
# 自定义域名（CDN / 绑定域名），留空则用默认 OSS 域名
OSS_CUSTOM_DOMAIN=
OSS_DIR_PREFIX=lab-reserve

# ---------- SMTP 邮件（迭代 3 用到）----------
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=change-me@qq.com
# ⚠️ QQ 邮箱 / 163 邮箱必须用开通 SMTP 后生成的「授权码」（16 位），不是登录密码
MAIL_PASSWORD=change-me-smtp-auth-code
MAIL_FROM_NAME=实验室预约管理系统
# SMTP 传输方式：QQ 邮箱 465 端口用 ssl=true、auth=true（默认）。
# 本地调试 SMTP（scripts/tools/dev_smtp.py，端口 1025）时改成 false / false 即可，不用改代码。
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL=true
# 邮件投递参数（可选，默认值见 application.yml）
# MAIL_POLL_INTERVAL_MS=2000
# MAIL_RECLAIM_INTERVAL_MS=30000
# MAIL_RETRY_MIN_IDLE_SECONDS=60

# ---------- RAG 模块（迭代 R0 骨架起生效；缺凭据时会自动禁用） ----------
# 总开关；设为 false 后 R0 / R1 骨架也能跑（不会创建任何外部连接的 Bean）
RAG_ENABLED=false
# 启用 RAG 时还必须把这两项切成 openai（默认 none：Spring AI 缺 api-key 时会拒绝启动）
# 注：R2 的 Embedding 走自写的 DashScopeEmbeddingClient（JDK HttpClient），
#     不依赖 Spring AI 自动装配，所以 SPRING_AI_MODEL_EMBEDDING 可以一直是 none。
#     SPRING_AI_MODEL_CHAT 只在 R3 起需要（ChatClient 走 Spring AI ChatModel）。
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_EMBEDDING=none
# LLM 提供商凭据（以 .env 为准；不要提交任何脱敏后的真实 key）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=change-me-llm-api-key
LLM_CHAT_MODEL=deepseek-chat
LLM_EMBEDDING_MODEL=text-embedding-v3
# Qdrant 向量库（本地 Docker；与 docker-compose.yml 一致）
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# ---------- 前端 ----------
FRONTEND_PORT=80
