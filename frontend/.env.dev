# ============================================================
# 开发环境变量（npm run dev）
# 由 vite 的 --mode dev 加载
# ============================================================

VITE_APP_TITLE=实验室预约管理系统

# 浏览器请求前缀。开发时由 vite proxy 转发，生产时由 nginx 反代
VITE_API_BASE_URL=/api

# vite 开发服务器的代理目标
VITE_PROXY_TARGET=http://localhost:8080
